//! The preclude for Surab which is implicitly imported in all Surab modules.
//! It contains fundemantal and built in types and functions.

@public
struct None { }

@public
struct Number { }

@public
struct Char { }

@public
struct Bool { }

@public
fn print_n(value: Number) {
    surabrt_print_n(value);
}

@public
fn print_b(value: Bool) {
    surabrt_print_b(value);
}

// ---
// To be moved once we can import modules.
// ---

@public @extern
fn surabrt_print_n(value: Number);

@public @extern
fn surabrt_print_b(value: Bool);
