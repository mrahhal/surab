// This preclude is included in all surab compilations.

@public
struct None { }

@public
struct Number { }

@public
struct Char { }

@public
struct Bool { }

@public
fn print_n(value: Number) {
    surabrt_print_n(value);
}

@public @extern
fn surabrt_print_n(value: Number);

@public
fn print_b(value: Bool) {
    surabrt_print_b(value);
}

@public @extern
fn surabrt_print_b(value: Bool);
