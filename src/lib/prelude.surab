//! The prelude for Surab which is implicitly imported in all Surab modules.
//! It contains fundemantal and built in types and functions.

/// Represents a surab type's info.
@public
struct SurabType { }

@public
struct None { }

@public
struct i32 { }

@public
struct i64 { }

@public
struct u32 { }

@public
struct u64 { }

@public
struct f32 { }

@public
struct f64 { }

@public
struct bool { }

@public
struct char { }

@public
struct string { }

@public
fn print_i32(value: i32) {
	surabrt_print_i32(value);
}

@public
fn print_f64(value: f64) {
	surabrt_print_f64(value);
}

@public
fn print_bool(value: bool) {
	surabrt_print_bool(value);
}

@public
fn print_string(value: string) {
	surabrt_print_string(value);
}

// ---
// To be moved once we can import modules.
// ---

@public @extern
fn surabrt_print_i32(value: i32);

@public @extern
fn surabrt_print_f64(value: f64);

@public @extern
fn surabrt_print_bool(value: bool);

@public @extern
fn surabrt_print_string(value: string);
