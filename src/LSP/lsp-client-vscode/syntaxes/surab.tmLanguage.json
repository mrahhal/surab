{
	"$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
	"name": "Surab",
	"scopeName": "source.surab",
	"patterns": [
		{
			"include": "#keywords"
		}
	],
	"repository": {
		"keywords": {
			"name": "keyword.control.surab",
			"match": "(?<!@)\\b(fn|struct|alias|true|false|var|const|return)\\b"
		}
	}
}
