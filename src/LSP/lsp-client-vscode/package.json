{
	"name": "surab-lsp-client-vscode",
	"description": "The LSP VS Code Client for Surab.",
	"author": "Mohammad Rahhal",
	"license": "MIT",
	"version": "0.0.1",
	"publisher": "mrahhal",
	"repository": {
		"type": "git",
		"url": "https://github.com/mrahhal/surab"
	},
	"engines": {
		"vscode": "^1.98.0"
	},
	"main": "./out/extension",
	"dependencies": {
		"vscode-languageclient": "^9.0.1"
	},
	"devDependencies": {
		"@types/node": "^20.10.4",
		"@types/vscode": "^1.98.0",
		"@vscode/test-electron": "^2.4.1",
		"typescript": "^5.8.2"
	},
	"scripts": {
		"compile": "tsc -b",
		"watch": "tsc -b -w"
	},
	"contributes": {
		"viewsContainers": {
			"activitybar": [
				{
					"id": "surab-debug",
					"title": "Surab (debug)",
					"icon": "$(list-tree)"
				}
			]
		},
		"views": {
			"surab-debug": [
				{
					"id": "surab-debug-syntax-tree",
					"name": "Syntax Tree",
					"icon": "$(list-tree)"
				}
			]
		},
		"viewsWelcome": [
			{
				"view": "surab-debug-syntax-tree",
				"contents": "Nothing to show..."
			}
		],
		"languages": [
			{
				"id": "surab",
				"aliases": [
					"Surab"
				],
				"extensions": [
					".srb"
				],
				"configuration": "./language-configuration.json"
			},
			{
				"id": "surab-markdown-injection"
			}
		],
		"grammars": [
			{
				"language": "surab",
				"scopeName": "source.surab",
				"path": "./syntaxes/surab.tmLanguage.json"
			},
			{
				"language": "surab-markdown-injection",
				"scopeName": "markdown.surab.codeblock",
				"path": "./syntaxes/surab.markdown.injection.tmLanguage.json",
				"injectTo": [
					"text.html.markdown"
				],
				"embeddedLanguages": {
					"meta.embedded.block.surab": "surab"
				}
			}
		]
	},
	"configurationDefaults": {
		"surab": {
			"editor.semanticHighlighting.enabled": true
		}
	},
	"activationEvents": [
		"workspaceContains:**/surab-project.json"
	]
}
