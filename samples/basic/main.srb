import sub;

alias @extern fn (S2) as Delegate1;

/*
/* c */ const /* c */ /* c */ a /* c */ = /* c */ 2 /* c */; // c
*/

struct S1 {
	a: f64;
	b: bool;

	c: i32 = 0;

	(c: i32 = 3) {
		this.c = c;
	}

	get_number() i32 { this.c }
}

@extern
struct S2 {
	a: f64;
}

@extern
fn print_from_rust(s2: S2);

@extern
fn f(x: f64, y: f64) f64 {
	var e = x + y;
	return e + 1.0;
}

fn fs(s1: S1, s2: S2) {
	print_f64(s1.a);
	print_f64(s2.a);
}

fn main() {
	var a = 2.0;
	fn noop() { }
	noop();
	var b: f64 = 4.0;
	var c = f(a, b);
	c = {
		var c2 = 999.0;
		c2 + 0.2
	};
	print_f64(c);
	print_i32(41 + 1);

	var s1 = S1.{
		a = 82.0,
		b = true,
		c = 4,
	};
	print_f64(s1.a);
	s1.a = 83.0;
	print_f64(s1.a);
	print_bool(s1.b);

	var s1_number = s1.get_number();

	var s2 = S2.{ a = 42.3 };

	fs(s1, s2);

	print_from_rust(s2);

	// Fn pointers
	var fn_ptr /* : @extern fn (f64, f64) f64 */ = f;
	print_f64(fn_ptr(2.0, 3.0));

	var fn_ptr: @extern fn (S2) = print_from_rust;
	fn_ptr(s2);

	var fn_ptr: Delegate1 = print_from_rust;
	fn_ptr(s2);

	add(42);
	sub::sub(42);
}
